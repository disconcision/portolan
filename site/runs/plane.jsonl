{"t":3,"type":"files","files":{"lib/path.re":"/* Paths: lists of points. No interface, so everything is exported. */\n\ntype t = list(Point.t);\n\ntype ends = option(Point.pair);\n\nlet start: t = [Point.origin];\n\nlet shift = (d: Point.t, path: t): t => List.map(Point.add(d), path);\n\nlet ends = (path: t): ends =>\n  switch (path) {\n  | [] => None\n  | [first, ...rest] =>\n    Some((first, List.fold_left((_, p) => p, first, rest)))\n  };\n\nlet test_shift_start = () =>\n  assert(shift({x: 1, y: 2}, start) == [{x: 1, y: 2}]);\n","lib/point.re":"/* Points on the plane, in Reason. */\n\ntype t = {\n  x: int,\n  y: int,\n};\n\ntype pair = (t, t);\n\nlet origin: t = {x: 0, y: 0};\n\nlet add = (a: t, b: t): t => {\n  x: a.x + b.x,\n  y: a.y + b.y,\n};\n\n/* private: not in the interface */\nlet factor = 2;\n\nlet double = (p: t): t => {\n  x: p.x * factor,\n  y: p.y * factor,\n};\n\nmodule Grid = {\n  /* private: not in the interface */\n  let floor = (step: int, n: int): int => n / step * step;\n\n  let snap = (step: int, p: t): t => {\n    x: floor(step, p.x),\n    y: floor(step, p.y),\n  };\n};\n"}}
